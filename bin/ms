#!/usr/bin/env python3
"""ms — the machine-state projector.

Realises canonical content into the locations resident agents expect, one way only.
See SUBSTRATE.md for the contract this implements.

Stdlib only. Never invokes git. Never runs as root. Never touches the network.
"""

import datetime
import difflib
import hashlib
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import tomllib

REPO = pathlib.Path(__file__).resolve().parent.parent
ADAPTERS = REPO / "adapters"
TOOLING = REPO / "canonical" / "tooling"
STATE = REPO / "state" / "projection.json"
TOOLSTATE = REPO / "state" / "tooling.json"
MACHINE = REPO / "state" / "machine.json"

# Grants say what may run unattended. They cannot live in canonical/: that is
# agent-writable by design, so an agent could widen its own authority. Root
# ownership is the only boundary available on this machine without new
# machinery — verified 2026-09-02, sudo requires a password here.
GRANTS = pathlib.Path("/etc/machine-state/grants.toml")

# marker wrappers, composed from `marker` + `comment` alone — never inferred from the file
COMMENT = {
    "html": ("<!-- BEGIN {m} -->", "<!-- END {m} -->"),
    "hash": ("# BEGIN {m}", "# END {m}"),
    "dash": ("-- BEGIN {m}", "-- END {m}"),
}

OK, DRIFT, MISSING, FOREIGN = "in-sync", "drifted", "missing", "foreign"


def die(msg, code=2):
    print(f"ms: {msg}", file=sys.stderr)
    raise SystemExit(code)


def sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def now_iso() -> str:
    """UTC, in the same shape dcg's journal uses, so the two compare directly."""
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


# ---------------------------------------------------------------- manifests

# What may be an adapter source. Until 2026-09-02 this rule existed only in
# SUBSTRATE.md, and an unenforced rule is a rule that gets broken quietly: a file
# generated by `cap render` had come to sit in canonical/ and be read as a
# canonical source, which is how a derived intermediate acquired the ownership
# class of authored truth without anyone deciding it should.
#
# Both classes are legitimate inputs and they are legitimate for different
# reasons. CANONICAL is what a human decided. DERIVED is what a tool here
# produced from what a human decided — still ours, still reproducible, still in
# the repository, but authored by nobody. Nothing else may be a source: a vendor
# path would make us project another tool's output as though it were our
# decision, and a path outside the repository would break the rule that the
# repository is the source of truth.
SOURCE_ROOTS = ("canonical/", "derived/")


def check_source(t, rel):
    if not any(rel.startswith(r) for r in SOURCE_ROOTS):
        die(f"{t['adapter']}: source {rel!r} is outside "
            f"{' and '.join(SOURCE_ROOTS)} — a source must be authored here "
            f"(canonical/) or produced here from what was authored (derived/)")
    if ".." in pathlib.PurePath(rel).parts or pathlib.PurePath(rel).is_absolute():
        die(f"{t['adapter']}: source {rel!r} must be a plain repository-relative path")


def load_targets():
    """Every target from every adapter, in file then declaration order."""
    if not ADAPTERS.is_dir():
        die(f"no adapters directory at {ADAPTERS}")
    out = []
    for toml in sorted(ADAPTERS.glob("*.toml")):
        try:
            doc = tomllib.loads(toml.read_text())
        except tomllib.TOMLDecodeError as exc:
            die(f"{toml.name}: {exc}")
        for i, t in enumerate(doc.get("target", [])):
            for key in ("kind", "path", "sources"):
                if key not in t:
                    die(f"{toml.name} target #{i + 1}: missing '{key}'")
            if t["kind"] not in ("render", "link", "splice"):
                die(f"{toml.name} target #{i + 1}: unknown kind {t['kind']!r}")
            if t["kind"] == "splice":
                for key in ("marker", "comment"):
                    if key not in t:
                        die(f"{toml.name} target #{i + 1}: splice needs '{key}'")
                if t["comment"] not in COMMENT:
                    die(f"{toml.name} target #{i + 1}: unknown comment {t['comment']!r}")
            t = dict(t)
            t["adapter"] = toml.stem
            for rel in t["sources"]:
                check_source(t, rel)
            out.append(t)
    return out


def dest(t) -> pathlib.Path:
    """Resolve the parent chain but never the final component.

    A plain .resolve() follows the target's own symlink, so a `link` target would
    read back as the directory it points at rather than as a symlink.
    """
    p = pathlib.Path(t["path"]).expanduser()
    p = p if p.is_absolute() else (REPO / p)
    return p.parent.resolve() / p.name


def key(t) -> str:
    return str(dest(t))


def markers(t):
    b, e = COMMENT[t["comment"]]
    return b.format(m=t["marker"]).encode(), e.format(m=t["marker"]).encode()


# ---------------------------------------------------------------- canonical

def fragments(t) -> bytes:
    """Concatenate sources in order: one blank line between, trailing newline."""
    parts = []
    for rel in t["sources"]:
        src = REPO / rel
        if not src.exists():
            die(f"{t['adapter']}: source does not exist: {rel}")
        parts.append(src.read_bytes().rstrip(b"\n"))
    return b"\n\n".join(parts) + b"\n"


def region(t) -> bytes:
    b, e = markers(t)
    return b + b"\n" + fragments(t) + e + b"\n"


def link_source(t) -> pathlib.Path:
    if len(t["sources"]) != 1:
        die(f"{t['adapter']}: link takes exactly one source, got {len(t['sources'])}")
    src = (REPO / t["sources"][0]).resolve()
    if not src.is_dir():
        die(f"{t['adapter']}: link source is not a directory: {t['sources'][0]}")
    return src


# ---------------------------------------------------------------- splice ops

def find_region(text: bytes, begin: bytes, end: bytes):
    """(start, stop) of our region including a trailing newline, or None."""
    i = text.find(begin)
    if i == -1:
        return None
    j = text.find(end, i)
    if j == -1:
        die(f"unbalanced markers: found {begin.decode()} without its END")
    j += len(end)
    if text[j:j + 1] == b"\n":
        j += 1
    return i, j


def splice(text: bytes, begin: bytes, end: bytes, new: bytes) -> bytes:
    span = find_region(text, begin, end)
    if span is None:
        if text == b"":
            return new
        # No cosmetic padding. Every byte we add outside our markers is a byte
        # unproject cannot take back, so we add only the newline that keeps our
        # BEGIN on a line of its own.
        return text + (b"" if text.endswith(b"\n") else b"\n") + new
    return text[:span[0]] + new + text[span[1]:]


# ---------------------------------------------------------------- state file

def load_state():
    """The record, refused if it was written by a different repo or a different HOME.

    A projection record holds ABSOLUTE paths, so it is specific to one checkout
    on one machine and means nothing anywhere else. Carrying it somewhere else is
    not merely useless, it is dangerous: orphan reconciliation removes recorded
    targets that no manifest claims any more, and a record inherited from
    elsewhere names targets outside this tree entirely.

    That is not hypothetical. A test copied the live `state/` into a sandbox,
    dropped all but one adapter, and ran project; the six now-unclaimed records
    still pointed at the real $HOME and the real repository, so a supposedly
    hermetic test unprojected the live workstation. The sandbox was a copy of
    everything except the one file that pointed outside it.

    So identity is recorded and checked. A foreign record is ignored rather than
    acted on, and a fresh one is written for this pair.
    """
    ident = {"repo": str(REPO), "home": str(pathlib.Path.home())}
    if not STATE.exists():
        return {"schema": 1, "for": ident, "targets": {}}
    try:
        state = json.loads(STATE.read_text())
    except json.JSONDecodeError as exc:
        die(f"{STATE}: {exc}")
    was = state.get("for")
    if was is not None and was != ident:
        print(f"ms: ignoring {STATE.name}: it was written for repo {was.get('repo')} "
              f"and home {was.get('home')}, not this pair. Its records name paths "
              f"outside this tree and will not be touched.", file=sys.stderr)
        return {"schema": 1, "for": ident, "targets": {}}
    state["for"] = ident
    return state


def save_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    state.setdefault("for", {"repo": str(REPO), "home": str(pathlib.Path.home())})
    write_atomic(STATE, (json.dumps(state, indent=2, sort_keys=True) + "\n").encode())


def write_atomic(path: pathlib.Path, data: bytes):
    """Temp file in the same directory, then os.replace — a reader never sees a partial file.

    mkstemp creates 0600, so the mode is set explicitly: an existing file keeps the mode it
    had (splicing into a vendor file must not quietly change its permissions), and a new one
    gets 0644 rather than inheriting the temp file's private mode.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        mode = path.stat().st_mode & 0o7777
    except FileNotFoundError:
        mode = 0o644
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------- inspection

def inspect(t, record):
    """(status, detail). Never writes."""
    p = dest(t)
    if t["kind"] == "link":
        want = link_source(t)
        if not p.is_symlink() and not p.exists():
            return MISSING, f"-> {want}"
        if p.is_symlink():
            have = pathlib.Path(os.readlink(p))
            if have == want:
                return OK, f"-> {want}"
            if record:
                return DRIFT, f"points at {have}, expected {want}"
            return FOREIGN, f"symlink we have no record of, -> {have}"
        return FOREIGN, "exists and is not a symlink"

    if t["kind"] == "splice":
        if not p.exists():
            return MISSING, "file absent"
        text = p.read_bytes()
        b, e = markers(t)
        span = find_region(text, b, e)
        if span is None:
            return MISSING, "our region is absent"
        have = text[span[0]:span[1]]
        return (OK, "region matches") if have == region(t) else (DRIFT, "region differs")

    want = fragments(t)
    if not p.exists():
        return MISSING, ""
    have = p.read_bytes()
    if have == want:
        return OK, ""
    if record:
        return DRIFT, "content differs from canonical"
    return FOREIGN, "exists, we have no record of it, and it is not what canonical would produce"


def may_write(status):
    """Canonical wins over our own drift; it never wins over somebody else's file."""
    return status != FOREIGN


def orphans(state, targets):
    """Records no live target claims — e.g. a target dropped from a manifest."""
    live = {key(t) for t in targets}
    return [(k, r) for k, r in sorted(state["targets"].items()) if k not in live]


def remove_recorded(path: pathlib.Path, rec):
    """Undo one projection using only its record. Conservative: never destroys an edit.

    Used for both `unproject` and orphan reconciliation, so the two can never
    diverge in how carefully they remove things.
    """
    kind = rec.get("kind")
    if kind == "link":
        if path.is_symlink():
            path.unlink()
            return "removed"
        return "absent"

    if kind == "splice":
        if not path.exists():
            return "absent"
        begin = COMMENT[rec["comment"]][0].format(m=rec["marker"]).encode()
        end = COMMENT[rec["comment"]][1].format(m=rec["marker"]).encode()
        text = path.read_bytes()
        span = find_region(text, begin, end)
        if span is None:
            return "absent"
        write_atomic(path, text[:span[0]] + text[span[1]:])
        return "removed"

    if not path.exists():
        return "absent"
    if rec.get("sha") and sha(path.read_bytes()) != rec["sha"]:
        return "edited"  # a human changed it after we wrote it; not ours to delete
    path.unlink()
    return "removed"


# ---------------------------------------------------------------- subcommands

def cmd_project(_argv):
    state = load_state()
    targets = load_targets()
    refused = []
    for t in targets:
        k = key(t)
        rec = state["targets"].get(k)
        status, detail = inspect(t, rec)
        if not may_write(status):
            refused.append((t, detail))
            print(f"  REFUSED  {t['kind']:<7} {t['path']}  ({detail})")
            continue

        p = dest(t)
        # "when we last WROTE this target", not "when we last ran project" — a
        # fresh timestamp on an unchanged target would make projection
        # non-idempotent, and would move the attribution window for no reason.
        stamp = rec.get("projected_at", now_iso()) if (rec and status == OK) else now_iso()
        if t["kind"] == "link":
            src = link_source(t)
            if status != OK:
                p.parent.mkdir(parents=True, exist_ok=True)
                if p.is_symlink() or p.exists():
                    p.unlink()
                p.symlink_to(src)
            state["targets"][k] = {"kind": "link", "adapter": t["adapter"], "source": str(src),
                                   "projected_at": stamp}
        elif t["kind"] == "splice":
            text = p.read_bytes() if p.exists() else b""
            b, e = markers(t)
            new = region(t)
            if status != OK:
                write_atomic(p, splice(text, b, e, new))
            state["targets"][k] = {
                "kind": "splice", "adapter": t["adapter"], "marker": t["marker"],
                "comment": t["comment"], "region_sha": sha(new), "sources": t["sources"],
                "projected_at": stamp,
            }
        else:
            data = fragments(t)
            if status != OK:
                write_atomic(p, data)
            state["targets"][k] = {
                "kind": "render", "adapter": t["adapter"],
                "sha": sha(data), "sources": t["sources"], "projected_at": stamp,
            }
        verb = "unchanged" if status == OK else ("created" if status == MISSING else "restored")
        print(f"  {verb:<9} {t['kind']:<7} {t['path']}")

    for k, rec in orphans(state, targets):
        verb = remove_recorded(pathlib.Path(k), rec)
        if verb == "edited":
            print(f"  kept      orphan  {k}  (edited since we wrote it; left in place)")
        else:
            print(f"  {verb:<9} orphan  {k}")
        state["targets"].pop(k, None)

    save_state(state)
    if refused:
        print(f"\n{len(refused)} target(s) refused. Nothing was overwritten.", file=sys.stderr)
        print("Promote the file into canonical, or retarget the adapter.", file=sys.stderr)
        return 1
    return 0


_journal_cache = None


def journal():
    """The agent action journal, from dcg's command history.

    dcg records every command an agent runs through its hook, tagged with
    agent_type and session_id. That is not what it was built for, but it is the
    only agent-neutral record on this machine of what an agent actually did.
    Returns [] when history is disabled or dcg is absent — attribution then
    degrades to "unknown", never to a false accusation.
    """
    global _journal_cache
    if _journal_cache is None:
        _journal_cache = []
        try:
            r = subprocess.run(shlex.split("dcg history export -f json"),
                               capture_output=True, text=True, timeout=30)
            if r.returncode == 0 and r.stdout.strip():
                rows = json.loads(r.stdout)
                if isinstance(rows, list):
                    _journal_cache = rows
                else:
                    _journal_cache = rows.get("commands") or rows.get("entries") or []
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            pass
    return _journal_cache


def attribute(path: pathlib.Path, since):
    """Did an agent touch this path since we last projected it?

    A HINT, NEVER A VERDICT. The journal sees shell commands only: a harness's
    own file-editing tools write elsewhere, and another agent's may write
    nowhere at all. Absence of an entry is therefore not evidence that a human
    made the change — only that this record cannot say.
    """
    rows = journal()
    if not rows:
        return "no journal — dcg history is unavailable, so nothing can be attributed"
    needles = [str(path)]
    try:
        needles.append(str(path.relative_to(REPO)))
    except ValueError:
        pass
    needles.append(path.name)

    hits = sorted((r for r in rows if any(n in r.get("command", "") for n in needles)),
                  key=lambda r: r.get("timestamp", ""), reverse=True)
    if not hits:
        return "no agent command names it — but the journal sees shell only, so this is not proof"

    # SHOW THE EVIDENCE, DO NOT INFER FROM IT. dcg journals an entire shell block
    # as one entry, so a single record routinely holds a read of one file, a write
    # to another, and the projection that followed. Which of those touched this
    # path is not recoverable from the record. Anything claiming to know is
    # guessing, and a confident wrong attribution is worse than none — it names a
    # culprit and gets believed. So: report the most recent entry mentioning the
    # path and let the reader judge causation from the command itself.
    last = hits[0]
    who = last.get("agent_type", "an agent")
    stamp = last.get("timestamp", "")
    when = stamp[:19].replace("T", " ")
    rel = "since" if since and stamp > since else "before"
    # Window the excerpt around the mention. A block can be hundreds of
    # characters; the first 88 of them are rarely the reason it matched.
    cmd = " ".join(last.get("command", "").split())
    at = min((cmd.find(n) for n in needles if cmd.find(n) >= 0), default=0)
    lo, hi = max(0, at - 34), min(len(cmd), at + 54)
    cmd = ("…" if lo else "") + cmd[lo:hi] + ("…" if hi < len(cmd) else "")
    return (f"{who} mentioned it {len(hits)}x, last {when}Z ({rel} this projection)\n"
            f"             evidence: {cmd}")


def current_bytes(t):
    """What is actually at the target now: the whole file, or just our region."""
    p = dest(t)
    if not p.exists():
        return None
    if t["kind"] != "splice":
        return p.read_bytes()
    text = p.read_bytes()
    span = find_region(text, *markers(t))
    return text[span[0]:span[1]] if span else None


def cause(t, rec, status):
    """Why does this target differ — did canonical move, or was the target changed?

    state/projection.json records the hash of what we last wrote. A target still
    matching that hash differs only because canonical has moved ahead of it. A
    target matching neither was changed by something else. These want opposite
    responses, so reporting both as "drifted" hides the only thing worth knowing.
    """
    if status == MISSING:
        return "not projected yet"
    if status == FOREIGN:
        return "we have no record of creating it"
    if not rec:
        return "no record"
    if t["kind"] == "link":
        return "link points somewhere else"
    have = current_bytes(t)
    if have is None:
        return "our region is gone"
    recorded = rec.get("region_sha") if t["kind"] == "splice" else rec.get("sha")
    if recorded and sha(have) == recorded:
        return "canonical moved ahead — this is our own unapplied change"
    return "target changed since we wrote it"


def line_delta(t):
    """(+added, -removed) lines between what is there and what canonical would produce."""
    if t["kind"] == "link":
        return None
    have = current_bytes(t) or b""
    want = region(t) if t["kind"] == "splice" else fragments(t)
    add = rem = 0
    for line in difflib.unified_diff(have.decode(errors="replace").splitlines(),
                                     want.decode(errors="replace").splitlines(), n=0):
        if line.startswith("+") and not line.startswith("+++"):
            add += 1
        elif line.startswith("-") and not line.startswith("---"):
            rem += 1
    return add, rem


def grants_state():
    """(label, intact) — is the authority boundary standing?

    Two things are checked, not one. A file we cannot write is not enough: on
    POSIX, deleting a file needs write permission on its DIRECTORY, so a
    user-writable directory would let an agent replace the grants wholesale
    while the file itself looked correctly owned.

    Absence is safe and reported as such. Fail-closed means no grants is not a
    degraded state, it is the initial one: nothing runs unattended until
    something outside the agent's reach says otherwise.
    """
    d = GRANTS.parent
    if not d.exists():
        return f"no grants — nothing may run unattended ({d} absent)", True
    if os.access(d, os.W_OK):
        return f"COMPROMISED: {d} is writable by this user; grants can be replaced", False
    if not GRANTS.exists():
        return f"no grants — nothing may run unattended ({d} is root-owned)", True
    if os.access(GRANTS, os.W_OK) or GRANTS.stat().st_uid != 0:
        return f"COMPROMISED: {GRANTS} is writable by this user", False
    return "intact — root-owned, readable, not writable by this user", True


def cmd_propose(_argv):
    """Dry run. What would `ms project` change, and why — changing nothing.

    This is a REVIEW seam, not enforcement. It makes a change visible before it
    reaches the machine. It does not stop an agent editing canonical and running
    project anyway; that needs the grants mechanism in CAPABILITIES.md section 8.
    """
    state = load_state()
    targets = load_targets()
    pending = 0

    for t in targets:
        rec = state["targets"].get(key(t))
        status, detail = inspect(t, rec)
        if status == OK:
            continue
        pending += 1
        if status == FOREIGN:
            print(f"  REFUSE    {t['kind']:<7} {t['path']}")
            print(f"            {detail}")
            continue
        verb = "create" if status == MISSING else "update"
        d = line_delta(t)
        extent = f"  (+{d[0]} -{d[1]} lines)" if d else ""
        print(f"  {verb:<9} {t['kind']:<7} {t['path']}{extent}")
        print(f"            {cause(t, rec, status)}")

    for k, rec in orphans(state, targets):
        pending += 1
        print(f"  remove    {rec.get('kind', '?'):<7} {k}")
        print(f"            no adapter claims it any more")

    if not pending:
        print("  nothing pending — the machine matches canonical")
        return 0
    print(f"\n{pending} change(s) pending. Run 'ms project' to apply.", file=sys.stderr)
    return 1


def cmd_diff(_argv):
    state = load_state()
    targets = load_targets()
    drifted = 0
    for t in targets:
        rec = state["targets"].get(key(t))
        status, detail = inspect(t, rec)
        if status != OK:
            drifted += 1
            print(f"  {status:<8} {t['kind']:<7} {t['path']}" + (f"  ({detail})" if detail else ""))
            print(f"           ↳ {cause(t, rec, status)}")
            if status in (DRIFT, FOREIGN):
                print(f"           ↳ {attribute(dest(t), (rec or {}).get('projected_at'))}")
    for k, rec in orphans(state, targets):
        drifted += 1
        print(f"  orphan   {rec.get('kind', '?'):<7} {k}  (no adapter claims it any more)")
    if drifted:
        print(f"\n{drifted} target(s) differ from canonical.", file=sys.stderr)
        return 1
    print("  all targets match canonical")
    return 0


def read_tool_checks():
    """Machine-readable block inside each canonical/tooling/<tool>.md.

    Reading our own canonical records is not a projection; the content-agnostic rule
    in SUBSTRATE.md 4 constrains what the projector WRITES, not what status reads.
    """
    tools = []
    if not TOOLING.is_dir():
        return tools
    for rec in sorted(TOOLING.glob("*.md")):
        for block in re.findall(r"```toml\n(.*?)```", rec.read_text(), re.S):
            try:
                meta = tomllib.loads(block)
            except tomllib.TOMLDecodeError:
                continue
            if "check" in meta or "version" in meta:
                meta["name"] = rec.stem
                tools.append(meta)
                break
    return tools


# Shell operators that a record can write and this runner will NOT honour.
# Checks run through shlex.split with no shell, deliberately — running arbitrary
# shell out of canonical/ would widen what a tooling record can do. But a record
# containing `a && b` then reads as a conjunction and executes as `a` with `&&`
# and `b` handed to it as extra ARGUMENTS, which for grep means extra files to
# search. That is how the Codex wiring check came to report a guarded harness
# whose hook was not trusted: the first file matched and grep exited 0.
#
# A record that silently means something other than it says is the exact failure
# these records exist to prevent, so it is refused. Write `sh -c "a && b"` when a
# shell is genuinely wanted; the operators are then inside one token and the
# intent is visible in the record.
SHELL_OPS = {"&&", "||", "|", ";", ">", ">>", "<", "&"}


def run(cmd, cwd=None):
    argv = shlex.split(cmd)
    bad = [tok for tok in argv if tok in SHELL_OPS]
    if bad:
        die(f"check command uses {' '.join(bad)} but checks do not run in a shell; "
            f"wrap it as: sh -c {cmd!r}")
    try:
        r = subprocess.run(argv, cwd=cwd or REPO, capture_output=True,
                           text=True, timeout=30)
        return r.returncode, (r.stdout or r.stderr).strip()
    except (OSError, subprocess.SubprocessError):
        return None, ""


def installed_packages():
    """Every package with the date the local database says it was installed.

    QUERIED, NOT WATCHED, and that is the whole design. A watcher — a path unit on
    pacman.log, an inotify on the db — only sees events while it is running. A
    reboot, a crash, or a week when nothing ran and the event is gone with no way
    to recover it. The local database is authoritative and retroactive: it can be
    asked what changed since any moment, including moments when nothing was
    watching. No daemon, no unit, no root, no moving parts.
    """
    # Called directly rather than through run(): that helper splits on whitespace
    # for record-supplied commands, and this format string contains tabs.
    try:
        r = subprocess.run(["expac", "--timefmt=%s", "%l\t%n\t%v"], capture_output=True,
                           text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    out = r.stdout
    pkgs = {}
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 3 and parts[0].strip().isdigit():
            pkgs[parts[1]] = {"version": parts[2], "at": int(parts[0])}
    # A parse that yields nothing from real output is a silent failure, and this
    # one already happened: expac's %l is a formatted date unless --timefmt says
    # otherwise, so every line was discarded and an empty inventory was recorded
    # as though the machine had no packages. Refuse rather than record a lie.
    if out.strip() and not pkgs:
        die("expac returned output that could not be parsed; refusing to record "
            "an empty package inventory")
    return pkgs


def owning_package(binary):
    """Which package owns a binary — asked of the FILE, never matched by name.

    `pacman -Qo $(command -v codex)` answers `openai-codex`. Matching the binary
    name against `pacman -Qq` answers nothing, and did: codex was classified a
    loose binary needing root to update when it is an ordinary repo package. The
    package name and the command name are different strings and only the
    filesystem knows the mapping.
    """
    path = shutil.which(binary)
    if not path:
        return None, None
    rc, out = run(f"pacman -Qo {path}")
    if rc != 0 or " is owned by " not in out:
        return path, None
    return path, out.split(" is owned by ")[1].split()[0]


def loose_binaries(known=None):
    """Tools we depend on that no package owns, hashed because nothing else records them.

    dcg, bd and claude live in ~/.local/bin, are writable by this user and carry
    their own updaters. There is no database to ask when they last changed, so
    their content is the only evidence available.
    """
    out = {}
    for tool in read_tool_checks():
        cmd = (tool.get("version") or "").split()
        if not cmd:
            continue
        path, owner = owning_package(cmd[0])
        if path and owner is None:
            out[cmd[0]] = {"path": path,
                           "sha": sha(pathlib.Path(path).read_bytes())}
    # A tool already known is re-checked AT ITS RECORDED PATH rather than
    # re-resolved through PATH. Otherwise the inventory depends on the
    # environment `ms` happens to run in: a cron or hook with a narrower PATH
    # would find nothing in ~/.local/bin, silently drop three tools, and report
    # them as newly appeared on the next ordinary run. The machine did not
    # change; only the lookup did.
    for name, rec in (known or {}).items():
        if name in out:
            continue
        q = pathlib.Path(rec.get("path", ""))
        if q.is_file():
            out[name] = {"path": str(q), "sha": sha(q.read_bytes())}
        else:
            out[name] = {"path": rec.get("path", "?"), "sha": None, "gone": True}
    return out


def machine_state(known=None):
    """(packages, loose) as the machine is right now."""
    return installed_packages(), loose_binaries(known)


def cmd_changes(argv):
    """What changed since the mark, from state that is already recorded.

    Exit 1 when something changed, so it composes into a session-start check.
    `--record` accepts the current machine as seen.
    """
    mark_early = {}
    if MACHINE.exists():
        try:
            mark_early = json.loads(MACHINE.read_text())
        except json.JSONDecodeError:
            mark_early = {}
    pkgs, loose = machine_state(mark_early.get("loose"))
    if pkgs is None:
        print("ms: expac is not available; install pacman-contrib", file=sys.stderr)
        return 2
    mark = {}
    if MACHINE.exists():
        try:
            mark = json.loads(MACHINE.read_text())
        except json.JSONDecodeError as exc:
            die(f"{MACHINE}: {exc}")

    # A HOOK MAY NOT FREEZE THE INVENTORY. Without a mark this command would
    # create one, and `--quiet` is the session-start form: the least examined
    # environment on the machine would decide what "unchanged" means from then on.
    # Recording is an act of acceptance and belongs to whoever is looking.
    if not mark and "--quiet" in argv:
        print("machine-state: no mark yet; run 'ms changes --record' to take one.",
              file=sys.stderr)
        return 0

    if "--record" in argv or not mark:
        MACHINE.parent.mkdir(parents=True, exist_ok=True)
        write_atomic(MACHINE, (json.dumps(
            {"schema": 1, "recorded": now_iso(), "packages": pkgs, "loose": loose},
            indent=2, sort_keys=True) + "\n").encode())
        what = "recorded" if mark else "first run; recorded"
        print(f"  {what} {len(pkgs)} package(s) and {len(loose)} unpackaged tool(s)")
        return 0

    old_p, old_l = mark.get("packages", {}), mark.get("loose", {})
    added   = [n for n in pkgs if n not in old_p]
    removed = [n for n in old_p if n not in pkgs]
    changed = [n for n in pkgs if n in old_p and pkgs[n]["version"] != old_p[n]["version"]]
    moved   = [n for n in loose if n in old_l and loose[n]["sha"] != old_l[n]["sha"]]
    new_l   = [n for n in loose if n not in old_l]

    total = len(added) + len(changed) + len(removed) + len(moved) + len(new_l)
    if not total:
        # Quiet mode says nothing when nothing happened. A session-start hook that
        # reports "nothing changed" every single time trains its reader to skip
        # the line, and then the one time it says something they skip that too.
        if "--quiet" not in argv:
            print(f"  nothing changed since {mark.get('recorded', '?')}")
        return 0

    if "--quiet" in argv:
        print(f"machine-state: {total} change(s) on this machine since "
              f"{mark.get('recorded', '?')} —")
    for n in sorted(added):
        print(f"  added     {n} {pkgs[n]['version']}")
    for n in sorted(changed):
        print(f"  upgraded  {n} {old_p[n]['version']} -> {pkgs[n]['version']}")
    for n in sorted(removed):
        print(f"  removed   {n} {old_p[n]['version']}")
    for n in sorted(moved):
        if loose[n].get("gone"):
            print(f"  MISSING   {n} (unpackaged; not at {loose[n]['path']} any more)")
        else:
            print(f"  replaced  {n} (unpackaged; content changed at {loose[n]['path']})")
    for n in sorted(new_l):
        print(f"  appeared  {n} (unpackaged, at {loose[n]['path']})")

    print(f"\n{total} change(s) since {mark.get('recorded', '?')}. "
          f"File them, then run 'ms changes --record'.", file=sys.stderr)
    return 1


def resolve_tool_cmd(cmd, remembered):
    """Resolve a record's command against PATH, falling back to where it was last seen.

    Checks run whatever command the record names, and subprocess resolves that
    through PATH. Under a narrower PATH than an interactive shell — a cron, a
    systemd timer, a hook — the tools in ~/.local/bin resolve to nothing, and a
    record that now DECLARES the machine should have the tool would report three
    present tools as absent and fail the run.

    So the path where a tool was last found is remembered in state/tooling.json
    and used when PATH cannot find it. That is the same technique `ms changes`
    uses for unpackaged binaries, and for the same reason: an inventory that
    changes with the environment it is read from is not an inventory.

    A genuinely absent tool is still absent — the remembered path is checked for
    existence, not assumed.

    Returns (command, path, via), where `via` is "path" when PATH resolved it,
    "remembered" when only the recorded path could, and None when neither did.
    The caller needs that distinction: reaching a tool only by memory means this
    run's PATH is narrower than the machine's, which makes some verdicts
    statements about the run rather than about the machine.
    """
    argv = shlex.split(cmd)
    if not argv:
        return cmd, None, None
    found = shutil.which(argv[0])
    if found:
        return cmd, found, "path"
    seen = (remembered or {}).get(argv[0])
    if seen and pathlib.Path(seen).is_file() and os.access(seen, os.X_OK):
        return shlex.join([seen, *argv[1:]]), seen, "remembered"
    return cmd, None, None


def cmd_status(argv):
    """Report the machine as it is, and only record it when told to.

    THE INVENTORY IS ACCEPTED, NOT ACCUMULATED. state/tooling.json used to be
    rewritten by every run, so whatever the ambient environment happened to be
    able to see became the committed truth. A session without the compositor
    recorded hypr's version as "-"; a hook's PATH recorded dcg as "degraded".
    Neither was a fact about this machine. `ms changes` had the right shape all
    along — it reports freely and writes its mark only on `--record` — and this
    command now matches it. Reporting is cheap and safe; accepting is a decision.
    """
    record = "--record" in argv
    state = load_state()
    targets = load_targets()

    print("Targets")
    if not targets:
        print("  (no adapters declare any targets yet)")
    for t in targets:
        rec = state["targets"].get(key(t))
        status, detail = inspect(t, rec)
        print(f"  {t['adapter']:<8} {t['kind']:<7} {t['path']:<34} {status}"
              + (f"  ({detail})" if detail and status != OK else ""))
    for k, rec in orphans(state, targets):
        print(f"  {'-':<8} {rec.get('kind', '?'):<7} {k:<34} orphan  (no adapter claims it any more)")

    label, intact = grants_state()
    print(f"\nBoundary\n  grants   {'':<12} {label}")

    tools = read_tool_checks()
    prev = {}
    if TOOLSTATE.exists():
        try:
            prev = json.loads(TOOLSTATE.read_text()).get("tooling", {})
        except (json.JSONDecodeError, AttributeError, TypeError):
            prev = {}
    if not isinstance(prev, dict):
        prev = {}
    remembered = {v["binary"]: v["path"] for v in prev.values()
                  if isinstance(v, dict) and v.get("binary") and v.get("path")}
    observed = {}
    unguarded, absent, carried, differs = [], [], [], []
    if tools:
        groups = {}
        for tool in tools:
            groups.setdefault(tool.get("group", "Tooling"), []).append(tool)
        for group in sorted(groups):
            print(f"\n{group}")
            for tool in groups[group]:
                was = prev.get(tool["name"]) or {}
                if not isinstance(was, dict):
                    was = {}
                binary = (shlex.split(tool.get("version") or tool.get("check") or "") or [None])[0]
                where, blind = None, False

                # Every reading is either OBSERVED or NOT OBSERVED, and the two
                # are never allowed to look alike. A version command that fails
                # produced no reading at all; writing "-" over a known version
                # would turn "I could not look" into "there is nothing there".
                version, seen_version = "-", False
                if tool.get("version"):
                    cmd, where, via = resolve_tool_cmd(tool["version"], remembered)
                    blind = blind or via == "remembered"
                    rc, out = run(cmd)
                    if rc == 0 and out:
                        version, seen_version = out.splitlines()[0].strip(), True
                        # Optional: pull the version out of a chattier line.
                        # Explicit in the record — ms never guesses the shape.
                        if tool.get("version_re"):
                            m = re.search(tool["version_re"], version)
                            version = m.group(1) if m and m.groups() else version
                verdict, seen_verdict, rc = "unknown", False, None
                if tool.get("check"):
                    cmd, w2, via = resolve_tool_cmd(tool["check"], remembered)
                    where = where or w2
                    blind = blind or via == "remembered"
                    rc, _ = run(cmd)
                    if rc == 0:
                        verdict, seen_verdict = tool.get("ok", "ok"), True
                    elif rc is None:
                        # The command could not be executed at all — the tool is
                        # absent, which is a different fact from its check failing.
                        #
                        # AND ABSENCE IS A PROBLEM, because a record IS the
                        # declaration that this machine should have the thing. See
                        # SUBSTRATE.md §7.2: the registry of desired software is
                        # the set of tooling records, not a separate file. Writing
                        # a record and tolerating its absence would make the record
                        # a description of the past rather than a statement about
                        # the machine. Remove the record to stop wanting the tool.
                        verdict, seen_verdict = tool.get("missing", "unknown"), True
                        absent.append(tool["name"])
                    else:
                        verdict = tool.get("fail", "not configured")
                        # A FAILING CHECK IS ONLY A FACT ABOUT THE MACHINE IF THIS
                        # RUN COULD SEE THE MACHINE AS AN ORDINARY SESSION DOES.
                        # When a command had to be found at its remembered path,
                        # PATH here is narrower than PATH there, and a check that
                        # asks a question about PATH answers about the run instead.
                        # `dcg doctor --strict` does exactly that: under a hook's
                        # PATH it prints "binary in PATH... NOT FOUND" and exits 1
                        # while dcg is installed and working. Recording that as
                        # "degraded" files a fact about the environment under the
                        # machine's name.
                        seen_verdict = not blind

                # A harness that is present but not covered by the command guard is a
                # louder problem than anything else on this line, so it fails the run.
                # Absent tools are skipped: what is not installed cannot be unguarded.
                # An unobserved guard is not an unguarded one, so a lean run reports
                # neither — it says nothing it cannot stand behind.
                guarded, seen_guarded = None, False
                if tool.get("wiring") and rc is not None:
                    wcmd, _, wvia = resolve_tool_cmd(tool["wiring"], remembered)
                    guarded = run(wcmd)[0] == 0
                    seen_guarded = guarded or wvia != "remembered"
                    if not guarded and seen_guarded:
                        unguarded.append(tool["name"])

                # What this run could not see keeps what the record last saw, and
                # says so on the line rather than passing it off as fresh.
                if not seen_version and was.get("version"):
                    version = was["version"]
                if not seen_verdict and was.get("status"):
                    verdict = was["status"]
                if not seen_guarded and "guarded" in was:
                    guarded = was["guarded"]
                    seen_guarded = False
                unseen = [n for n, seen in (("version", seen_version or not tool.get("version")),
                                            ("status", seen_verdict or not tool.get("check")),
                                            ("wiring", seen_guarded or not tool.get("wiring")))
                          if not seen]
                if unseen:
                    carried.append(f"{tool['name']} ({', '.join(unseen)})")

                suffix = "" if guarded is not False else "   ** UNGUARDED **"
                note = "   (not observed this run; last seen)" if unseen else ""
                print(f"  {tool['name']:<8} {version:<12} {verdict}{suffix}{note}")
                rec = {"version": version, "status": verdict}
                # Remember where this tool was found, so a later run under a
                # narrower PATH can still reach it. Only recorded when actually
                # resolved: a guess would defeat the point. A run that resolved
                # nothing keeps the path the record already holds, for the same
                # reason it keeps the verdict.
                if binary and where:
                    rec["binary"], rec["path"] = binary, where
                elif was.get("binary") and was.get("path"):
                    rec["binary"], rec["path"] = was["binary"], was["path"]
                if guarded is not None:
                    rec["guarded"] = guarded
                observed[tool["name"]] = rec
                if was and rec != was:
                    differs.append(tool["name"])
    else:
        print("\n(no canonical/tooling records yet; nothing to verify)")

    if carried:
        print(f"\n{len(carried)} reading(s) this run could not take: "
              f"{', '.join(carried)}.")
        print("Shown from the record instead. Nothing here overwrites it.")

    # First run has no record to protect and no remembered paths to offer, so it
    # writes. Every run after that records only when asked. A reading that differs
    # is reported, never silently accepted, and it does not change the exit code:
    # this command already exits non-zero for the machine being wrong, and a
    # harness that updated itself overnight is not the machine being wrong.
    if observed and (record or not TOOLSTATE.exists()):
        write_atomic(TOOLSTATE, (json.dumps(
            {"schema": 1, "tooling": observed}, indent=2, sort_keys=True) + "\n").encode())
        if differs and record:
            print(f"\nrecorded: {', '.join(sorted(differs))}")
    elif differs:
        print(f"\n{len(differs)} reading(s) differ from the recorded inventory: "
              f"{', '.join(sorted(differs))}.", file=sys.stderr)
        print("Accept them with 'ms status --record'.", file=sys.stderr)

    if not intact:
        print("\nThe authority boundary is compromised. Grants decide what may run",
              file=sys.stderr)
        print("unattended; if this user can write them, an agent can widen its own.",
              file=sys.stderr)
        return 1

    if absent:
        print(f"\n{', '.join(absent)}: recorded here but not installed.", file=sys.stderr)
        print("A tooling record declares that this machine should have the tool. "
              "Install it, or delete the record to stop wanting it.", file=sys.stderr)

    if unguarded:
        print(f"\n{', '.join(unguarded)}: installed but not covered by the command guard.",
              file=sys.stderr)
        print("Wire it before trusting an agent in it — see canonical/tooling/dcg.md.",
              file=sys.stderr)

    if absent or unguarded:
        return 1
    return 0


def cmd_unproject(_argv):
    """Remove every projection we hold a record for — manifest targets and orphans alike."""
    state = load_state()
    by_key = {key(t): t for t in load_targets()}
    recorded = sorted(state["targets"].items())
    kept = 0

    for k, rec in recorded:
        label = by_key[k]["path"] if k in by_key else k
        verb = remove_recorded(pathlib.Path(k), rec)
        if verb == "edited":
            kept += 1
            print(f"  kept      {rec.get('kind', '?'):<7} {label}  (edited since we wrote it; left in place)")
            continue
        print(f"  {verb:<9} {rec.get('kind', '?'):<7} {label}")
        state["targets"].pop(k, None)

    for k, t in by_key.items():
        if k not in dict(recorded) and dest(t).exists():
            print(f"  skipped   {t['kind']:<7} {t['path']}  (no record; not ours to remove)")

    save_state(state)
    if kept:
        print(f"\n{kept} target(s) kept because they were edited after projection.", file=sys.stderr)
    return 0


COMMANDS = {"project": cmd_project, "propose": cmd_propose, "diff": cmd_diff,
            "changes": cmd_changes,
            "status": cmd_status, "unproject": cmd_unproject}


def main(argv):
    if os.geteuid() == 0:
        die("refusing to run as root; the substrate is user-scope only")
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        print("\nusage: ms {" + " | ".join(COMMANDS) + "}")
        return 0 if len(argv) >= 2 else 2
    if argv[1] not in COMMANDS:
        die(f"unknown command {argv[1]!r}; expected one of {', '.join(COMMANDS)}")
    return COMMANDS[argv[1]](argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
