#!/usr/bin/env python3
"""cap — the capability surface for this workstation.

A peer to bin/ms, never part of it. ms governs durable projection and drift; cap
governs runtime action. See CAPABILITIES.md.

This is the machine-state-bru.6 slice: the smallest thing that proves human,
desktop and agent operate from one model. A declaration set — one role, one
action, one key binding — drives three surfaces:

    the live Hyprland key      via `cap render` then `ms project`
    the shortcut preview       via `cap preview`
    the agent-readable action  via `cap list --json`

If those three can disagree there is no shared model.

PROVISIONAL. The file layout under canonical/ is an experimental fixture, not the
registry schema. machine-state-bru.7 defines roles, actions and key bindings as
separate registries properly, and is expected to move all of this.

Stdlib only. Never root, never sudo, no network.
"""

import datetime
import json
import os
import pathlib
import re
import shlex
import subprocess
import sys
import tempfile
import tomllib

REPO = pathlib.Path(__file__).resolve().parent.parent
ROLES = REPO / "canonical" / "roles"
ACTIONS = REPO / "canonical" / "actions"
BINDINGS = REPO / "canonical" / "bindings"
RENDERED = REPO / "derived" / "hypr" / "bindings.lua"
JOURNAL = REPO / "state" / "actions.jsonl"

# The compositor's own binding file, read to answer "is this chord already taken".
VENDOR_BINDS = pathlib.Path.home() / ".config" / "hypr" / "config" / "binds.lua"


def die(msg, code=2):
    print(f"cap: {msg}", file=sys.stderr)
    raise SystemExit(code)


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


# ---------------------------------------------------------------- declarations

def _load(d, key):
    out = {}
    if not d.is_dir():
        return out
    for f in sorted(d.glob("*.toml")):
        try:
            doc = tomllib.loads(f.read_text())
        except tomllib.TOMLDecodeError as exc:
            die(f"{f.name}: {exc}")
        for name, body in doc.get(key, {}).items():
            if name in out:
                die(f"duplicate {key} {name!r} in {f.name}")
            body["_source"] = str(f.relative_to(REPO))
            out[name] = body
    return out


# Declarations are validated on load, in one place, because a malformed one that
# survives loading fails later somewhere unrelated: `cap act ... mail` used to
# discard the bare token, call the provider with no arguments, and surface a raw
# TypeError. The traceback named do_ensure, which is not where the mistake was.
#
# Unknown keys are rejected too, not ignored. A misspelled `windowclass` that is
# quietly dropped leaves a role that resolves no windows for a reason nothing
# reports — the declaration looks right and the behaviour is wrong, which is the
# hardest shape to debug and the easiest to prevent.

def _want(d, where, what, required, optional=()):
    allowed = set(required) | set(optional)
    for key in required:
        if key not in d:
            die(f"{where}: {what} is missing {key!r}")
    for key in d:
        if key not in allowed and not key.startswith("_"):
            die(f"{where}: {what} has unknown key {key!r}; "
                f"expected {', '.join(sorted(allowed))}")


def _str(v, where, what):
    if not isinstance(v, str) or not v.strip():
        die(f"{where}: {what} must be a non-empty string, got {v!r}")


def check_role(name, r, where):
    _want(r, where, f"role {name!r}", ("label", "command", "window_class"))
    _str(r["label"], where, f"role {name!r} label")
    _str(r["command"], where, f"role {name!r} command")
    if not shlex.split(r["command"]):
        die(f"{where}: role {name!r} command {r['command']!r} contains no executable")
    wc = r["window_class"]
    if not isinstance(wc, list) or not wc:
        die(f"{where}: role {name!r} window_class must be a non-empty list")
    for w in wc:
        _str(w, where, f"role {name!r} window_class entry")


def roles():
    out = _load(ROLES, "role")
    for name, r in out.items():
        check_role(name, r, r.get("_source", "?"))
    return out


VALID_CONSEQUENCE = {"observe", "report", "adjust", "commit"}


def actions():
    """Declared actions, with malformed ones REJECTED rather than tolerated.

    Invalid is a third state, distinct from unimplemented and unavailable: the
    declaration itself is wrong, so keeping it would put a lie in the catalogue.
    """
    acts = _load(ACTIONS, "action")
    for name, a in acts.items():
        where = a.get("_source", "?")
        if "." not in name:
            die(f"{where}: action {name!r} is not namespaced")
        if not a.get("label"):
            die(f"{where}: action {name!r} has no label")
        c = a.get("consequence")
        if c not in VALID_CONSEQUENCE:
            die(f"{where}: action {name!r} has unknown consequence {c!r}; "
                f"expected one of {', '.join(sorted(VALID_CONSEQUENCE))}")
    return acts


def check_keys(keys, where):
    """A chord is modifiers then one key. Anything else is rejected, not guessed.

    An unaccepted modifier name is a declaration the compositor may read
    differently from us, and a chord we and it disagree about is precisely the
    thing every other check here exists to prevent.
    """
    if not keys:
        die(f"{where}: key binding declares no keys")
    for k in keys[:-1]:
        u = k.upper()
        if u in MOD_ORDER:
            continue
        if u in MOD_ALIASES:
            die(f"{where}: modifier {k!r} is not accepted here; write "
                f"{MOD_ALIASES[u]!r} instead — one spelling per modifier, so two "
                f"declarations cannot name one chord and evade collision")
        die(f"{where}: {k!r} is not a modifier; expected one of "
            f"{', '.join(sorted(MOD_ORDER))} before the key")


def check_binding(b, where):
    _want(b, where, "key binding", ("keys", "action"), ("args", "label"))
    if not isinstance(b["keys"], list):
        die(f"{where}: key binding keys must be a list, got {b['keys']!r}")
    for k in b["keys"]:
        _str(k, where, "key binding key")
    _str(b["action"], where, "key binding action")
    if "label" in b:
        _str(b["label"], where, f"key binding {' + '.join(b['keys'])} label")
    args = b.get("args", {})
    if not isinstance(args, dict):
        die(f"{where}: key binding args must be a table, got {args!r}")
    for k, v in args.items():
        _str(v, where, f"key binding argument {k!r}")
    check_keys(b["keys"], where)


def key_bindings():
    """Our declared chords. Vendor chords are observed separately, never declared here."""
    out = []
    for f in sorted(BINDINGS.glob("*.toml")) if BINDINGS.is_dir() else []:
        try:
            doc = tomllib.loads(f.read_text())
        except tomllib.TOMLDecodeError as exc:
            die(f"{f.name}: {exc}")
        for b in doc.get("key_binding", []):
            b["_source"] = str(f.relative_to(REPO))
            check_binding(b, b["_source"])
            out.append(b)
    return out


# Canonical modifier order. Hyprland does not care in which order a declaration
# lists modifiers, so neither may we: SUPER + SHIFT + X and SHIFT + SUPER + X are
# the same chord and must collide. Comparing the declared strings would miss it.
MOD_ORDER = {"SUPER": 0, "CONTROL": 1, "ALT": 2, "SHIFT": 3, "MOD5": 4}

# ONE SPELLING PER MODIFIER, deliberately narrower than the compositor.
#
# Evidence for the accepted names: the modifier table compiled into
# /usr/bin/Hyprland (0.56.2) reads SHIFT, CONTROL, ALT, SUPER, WIN, MOD4, META,
# MOD5 as one contiguous run, with LOGO separately; CTRL, CAPS, MOD2 and MOD3 do
# not appear at all. Live modmasks agree with that table — 68 is SUPER+CONTROL,
# 69 adds SHIFT, 72 is SUPER+ALT.
#
# Why reject the aliases rather than fold them in: WIN, LOGO, MOD4 and META are
# very likely SUPER, but "very likely" is the wrong footing for chord identity.
# If they are aliases and we keep them distinct, WIN + X and SUPER + X are one
# chord that collision detection misses. If we canonicalise them on a guess and
# the guess is wrong, we invent a collision that does not exist. Accepting one
# spelling removes the question instead of answering it wrongly — and these are
# OUR declarations, so narrowing our own input language costs nothing. The
# vendor's file may spell them however it likes; it is read, not authored here.
#
# CTRL is rejected on the same footing, and it is the one that motivated this.
# It sat in MOD_ORDER as though valid. If the compositor takes it as an alias for
# CONTROL, then CTRL + X and CONTROL + X were one chord we treated as two. If it
# does not take it at all — which is what this binary indicates — a declaration
# using it rendered a binding that never loaded, while preview reported it
# owned and ok. Both are the same failure: a key described as working that is
# not. Rejecting the spelling closes both without needing to know which it was.
MOD_ALIASES = {"CTRL": "CONTROL", "WIN": "SUPER", "LOGO": "SUPER",
               "MOD4": "SUPER", "META": "SUPER"}


def chord_of(b):
    """The chord as DECLARED, for display."""
    return " + ".join(b["keys"])


def normalize_chord(keys):
    """The chord as MEANT, for comparison.

    Modifiers sorted into a canonical order and upper-cased, the key last. Two
    declarations that differ only in the order they list modifiers normalise to
    one string and therefore conflict, which is what the compositor would do.
    """
    ks = [k.upper() for k in keys]
    # dict.fromkeys de-duplicates while preserving order, so a declaration that
    # lists a modifier twice normalises the same as one that lists it once.
    mods = sorted(dict.fromkeys(k for k in ks if k in MOD_ORDER),
                  key=lambda k: MOD_ORDER[k])
    rest = [k for k in ks if k not in MOD_ORDER]
    return " + ".join(mods + rest)


def norm_of(b):
    return normalize_chord(b["keys"])


# ---------------------------------------------------------------- vendor chords

def _split_top(s):
    """The first argument of hl.bind(...), up to the top-level comma."""
    depth, q, out = 0, None, []
    for ch in s:
        if q:
            out.append(ch)
            if ch == q:
                q = None
            continue
        if ch in "\"'":
            q = ch
        elif ch in "([{":
            depth += 1
        elif ch in ")]}":
            if depth == 0:
                break
            depth -= 1
        elif ch == "," and depth == 0:
            break
        out.append(ch)
    return "".join(out).strip(), s[len(out) + 1:].strip()


def _resolve(expr, consts):
    """A Lua string concatenation, resolved only when every part is knowable.

    Returns None when it is not. A chord assembled at load time — `mainMod ..
    " + SHIFT + CONTROL + " .. key` inside a loop — cannot be read from the text,
    and guessing at it would put a chord in the table that may not exist.
    Unreadable is a fact worth reporting; a plausible invention is not.
    """
    parts, out = [p.strip() for p in expr.split("..")], []
    for part in parts:
        m = re.fullmatch(r'"([^"]*)"', part)
        if m:
            out.append(m.group(1))
        elif part in consts:
            out.append(consts[part])
        else:
            return None
    return "".join(out)


def vendor_bindings():
    """Every hl.bind in the compositor's configuration, with its provenance.

    Read live rather than cached. A chord observed free on one day is not free
    for ever: a CachyOS update can claim it, and a preview that trusted a stale
    observation would document a binding that no longer behaves as described.

    Returns (resolved, unresolved). The second list is not a parser failure to be
    swallowed — it is the honest count of bindings this file holds that cannot be
    read statically, and both the preview and check must say so. Silently
    dropping them is what made 45 vendor-held chords read as free.
    """
    if not VENDOR_BINDS.exists():
        return {}, []
    text = VENDOR_BINDS.read_text()
    src = str(VENDOR_BINDS).replace(str(pathlib.Path.home()), "~")
    consts = dict(re.findall(r'^local\s+(\w+)\s*=\s*"([^"]*)"', text, re.M))
    resolved, unresolved = {}, []
    for n, line in enumerate(text.splitlines(), 1):
        i = line.find("hl.bind(")
        if i < 0:
            continue
        first, rest = _split_top(line[i + len("hl.bind("):])
        # MINIMAL normalisation only: trim whitespace, then the single trailing
        # paren that closes hl.bind itself, so the expression stays balanced.
        # Nothing here tries to infer that a command means "open the file
        # manager". If the expression cannot be read reliably, show the
        # expression. Observed truth with limited meaning beats polished fiction.
        raw, _ = _split_top(rest)
        raw = raw.strip().rstrip(",").strip()
        chord = _resolve(first, consts)
        rec = {"raw": raw or rest.rstrip(")").strip(), "source": src, "line": n}
        if chord is None:
            unresolved.append({**rec, "expr": first})
            continue
        declared = " + ".join(k.strip() for k in chord.split("+") if k.strip())
        resolved.setdefault(normalize_chord([k.strip() for k in chord.split("+")]),
                            {**rec, "declared": declared})
    return resolved, unresolved


def vendor_chords():
    return vendor_bindings()[0]


def unreadable_risk(norm, unreadable=None):
    """Which unreadable vendor bindings COULD hold this chord.

    A binding whose key is computed still holds real chords; the file simply does
    not say which. But it does say the modifiers — `mainMod .. " + ALT + " .. key`
    is some SUPER + ALT chord whatever key turns out to be — and that is enough
    to tell "certainly free" apart from "cannot be determined from this file".

    Reporting neither is acceptable. Calling it free would be a claim the evidence
    does not support; calling it conflicted would refuse work on a guess.
    """
    if unreadable is None:
        unreadable = vendor_bindings()[1]
    mods = {k for k in norm.split(" + ") if k in MOD_ORDER}
    out = []
    for e in unreadable:
        parts = [x.strip() for x in e["expr"].split("..")]
        lit = []
        for part in parts:
            r = _resolve(part, _vendor_consts())
            if r is None:
                break
            lit.append(r)
        prefix = "".join(lit)
        # only when the computed piece is the KEY, not a modifier
        if not prefix.rstrip().endswith("+"):
            continue
        pm = {k.strip().upper() for k in prefix.split("+") if k.strip()}
        if pm == mods:
            out.append(f"{e['source']}:{e['line']} binds {prefix.strip()}<computed key>")
    return out


def _vendor_consts():
    if not VENDOR_BINDS.exists():
        return {}
    return dict(re.findall(r'^local\s+(\w+)\s*=\s*"([^"]*)"',
                           VENDOR_BINDS.read_text(), re.M))


_OWNER_CACHE = {}


def vendor_owner(path):
    """Who owns an observed binding file — attributed from EVIDENCE, not assumed.

    New user accounts on this system are seeded from /etc/skel, and /etc/skel is
    packaged. So if the live file is byte-identical to its skel counterpart, the
    package that owns the counterpart owns the content, and pacman will name it.

    The moment those bytes diverge the attribution stops being true, and the row
    must say so rather than keep crediting a package for a file someone has since
    edited. That is the whole point of deriving this instead of writing
    "cachyos" into a constant: the label degrades when the evidence does.
    """
    if path in _OWNER_CACHE:
        return _OWNER_CACHE[path]
    owner = "local"
    try:
        skel = pathlib.Path("/etc/skel") / path.relative_to(pathlib.Path.home())
        if skel.is_file() and skel.read_bytes() == path.read_bytes():
            r = subprocess.run(["pacman", "-Qo", str(skel)], capture_output=True, text=True)
            if r.returncode == 0:
                # "<path> is owned by <name> <version>"
                parts = r.stdout.split(" is owned by ")
                if len(parts) == 2:
                    owner = parts[1].split()[0]
    except (ValueError, OSError, FileNotFoundError):
        pass
    _OWNER_CACHE[path] = owner
    return owner


def check_chord(chord, ours=None):
    """(free, holder). The safeguard: verified against the live config each time.

    A chord observed free on one day is not free for ever — a CachyOS update can
    claim it — so this is never cached and never assumed from a prior run.

    Two of our own declarations claiming one chord is also a conflict, and a
    different one: the vendor case means do not take it, the self case means the
    declarations disagree with each other.
    """
    norm = normalize_chord(chord.split(" + ")) if isinstance(chord, str) else chord
    v = vendor_chords()
    if norm in v:
        e = v[norm]
        return False, f"vendor {e['source']}:{e['line']}: {e['raw'][:52]}"
    # Both claimants are named with their provenance, because "conflict" without
    # saying which two declarations conflict leaves the reader to grep for it.
    mine = [b for b in (ours if ours is not None else key_bindings()) if norm_of(b) == norm]
    if len(mine) > 1:
        who = "; ".join(f"{b['action']} ({b.get('_source','?')}"
                        + (f", declared as {chord_of(b)}" if chord_of(b) != norm else "") + ")"
                        for b in mine)
        return False, f"claimed {len(mine)}x by us: {who}"
    return True, None


# ---------------------------------------------------------------- hyprland facts

def clients():
    r = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True, timeout=10)
    if r.returncode != 0:
        die("hyprctl unavailable; is Hyprland running?")
    return json.loads(r.stdout)


def resolve_role(role_name):
    """Windows belonging to a role, by the role's declared identity.

    An agent asks for the mail role. It never guesses a title and never names an
    executable, which is the whole point of the role indirection.
    """
    r = roles().get(role_name)
    if not r:
        die(f"no such role: {role_name}")
    want = [w.lower() for w in r.get("window_class", [])]
    return [c for c in clients()
            if c.get("class", "").lower() in want or c.get("initialClass", "").lower() in want], r


# ---------------------------------------------------------------- provenance

def record(**fields):
    JOURNAL.parent.mkdir(parents=True, exist_ok=True)
    line = json.dumps({"schema": 1, "at": now(), **fields}, sort_keys=True) + "\n"
    with open(JOURNAL, "a") as fh:
        fh.write(line)


# ---------------------------------------------------------------- the action

def plan_ensure(role_name):
    """What ensure WOULD do. Running and not-running are different branches and
    the proposal must say which, because 'open' and 'focus' disagree exactly when
    the application is absent."""
    wins, role = resolve_role(role_name)
    if wins:
        w = wins[0]
        return {"branch": "focus", "role": role_name, "window": w["address"],
                "title": w.get("title", ""), "workspace": w["workspace"]["name"],
                "detail": f"focus existing window {w['address']} on workspace {w['workspace']['name']}"}
    return {"branch": "launch", "role": role_name, "command": role["command"],
            "detail": f"launch {role['command']}, wait for its window, then focus it"}


def active_window():
    try:
        r = subprocess.run(["hyprctl", "activewindow", "-j"],
                           capture_output=True, text=True, timeout=5)
        return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return None


def focus_window(addr):
    """(outcome, detail) — success is READ BACK, never assumed.

    Three separate lessons are compiled into this, each learned from this
    compositor rather than from documentation:

    1. The call form. Under the Lua config `hyprctl dispatch focuswindow
       address:X` is a SYNTAX ERROR — hyprctl wraps its argument as
       `return hl.dispatch(<arg>)`, so the argument must be a Lua expression.
       The previous code used the legacy form, which exits 7 every time. It had
       therefore never once focused a window, and reported ok for all of them.

    2. The exit code is not an outcome. A failed focus prints
       `warning: hl.focus: window not found` and STILL EXITS 0. Any check of
       returncode alone would have kept reporting success. `hyprctl eval` is
       worse: it swallows the warning entirely, which is why dispatch is used.

    3. Accepted is not done. Even a clean `ok` means the dispatcher took the
       request, so the focused window is read back and compared. When it cannot
       be confirmed the outcome is `unverified` — distinct from both ok and
       failed, because "we could not tell" is a different fact from "it did not
       work", and flattening them would put a guess in the journal.
    """
    try:
        r = subprocess.run(
            ["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as exc:
        return "failed", f"hyprctl did not run: {exc!r}"
    out = (r.stdout or r.stderr or "").strip()
    if r.returncode != 0:
        return "failed", f"hyprctl exited {r.returncode}: {out[:120]}"
    if out != "ok":
        return "failed", f"hyprctl: {out[:120]}"
    seen = active_window()
    if seen is None:
        return "unverified", "dispatch accepted; the focused window could not be read back"
    if seen.get("address") != addr:
        return "unverified", (f"dispatch accepted; focus is {seen.get('address')}, "
                              f"not {addr}")
    return "ok", None


def do_ensure(role_name, timeout=20.0):
    plan = plan_ensure(role_name)
    if plan["branch"] == "focus":
        outcome, detail = focus_window(plan["window"])
        if detail:
            plan["outcome_detail"] = detail
        return plan, outcome
    _, role = resolve_role(role_name)
    subprocess.Popen(shlex.split(role["command"]), start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    import time
    deadline = time.time() + timeout
    while time.time() < deadline:
        wins, _ = resolve_role(role_name)
        if wins:
            outcome, detail = focus_window(wins[0]["address"])
            plan["window"] = wins[0]["address"]
            if detail:
                plan["outcome_detail"] = detail
            return plan, outcome
        time.sleep(0.4)
    return plan, "timeout"


def plan_list(role_name=None):
    """An observe action changes nothing, so its proposal has nothing to warn about.

    The query/propose/act contract binds MUTATING actions: propose must exist so a
    change can be reviewed before it happens. For a read there is nothing to
    review, and demanding a proposal anyway would be ceremony rather than safety.
    """
    wins = resolve_role(role_name)[0] if role_name else clients()
    return {"branch": "read", "count": len(wins),
            "detail": f"read {len(wins)} window(s); changes nothing"}


def do_list(role_name=None):
    wins = resolve_role(role_name)[0] if role_name else clients()
    for w in wins:
        print(f"  {w['address']}  {w.get('class',''):<16} ws={w['workspace']['name']:<4} "
              f"{w.get('title','')[:44]}")
    return plan_list(role_name), "ok"


def requires_hyprland():
    try:
        r = subprocess.run(["hyprctl", "version"], capture_output=True, timeout=5)
        return (True, None) if r.returncode == 0 else (False, "Hyprland is not responding")
    except (OSError, subprocess.SubprocessError):
        return False, "hyprctl is not installed"


# DECLARATIONS COMPOSE THE SYSTEM; IMPLEMENTATIONS EXTEND ITS ABILITIES.
#
# Roles, bindings, labels, previews and catalogue entries are pure data and need
# no change here. A new semantic BEHAVIOUR needs provider code. That asymmetry is
# the point: it keeps the registry a protocol rather than a configuration-shaped
# programming language.
#
# Keys are provider OPERATION IDENTIFIERS, never shell commands. An identifier
# with no entry here is unimplemented — it is never executed as a command and
# never silently omitted.
PROVIDERS = {
    "desktop.application.ensure": (plan_ensure, do_ensure, requires_hyprland),
    "desktop.window.list": (plan_list, do_list, requires_hyprland),
}


def action_state(a):
    """(implemented, available, reason) — three independent facts, not one flag.

    unimplemented  a valid semantic action no provider implements; kept and shown
    unavailable    implemented, but its runtime dependency is absent; reason given
    """
    ident = a.get("implementation")
    if not ident:
        return False, False, "declaration names no implementation"
    prov = PROVIDERS.get(ident)
    if prov is None:
        return False, False, f"no provider implements {ident!r}"
    ok, why = prov[2]()
    return True, ok, None if ok else why


def dangling_bindings():
    """Bindings whose action no longer exists — the rename case.

    A renamed action leaves every binding that referenced it pointing at nothing.
    Rendering that produces an artifact carrying a stale identity, and a key that
    calls an action which cannot be found.
    """
    acts = actions()
    return [(chord_of(b), b["action"]) for b in key_bindings() if b["action"] not in acts]


def dangling_roles():
    """Bindings naming a role that no longer exists — the other rename case.

    An action reference is checked already; a role reference was not, and it
    fails differently and worse. resolve_role dies at invocation, so a keypress
    on such a binding produces no notification and no journal entry: the key
    appears to do nothing at all. Catching it where dangling actions are caught
    makes both reference kinds fail the same way, before projection.
    """
    known = set(roles())
    out = []
    for b in key_bindings():
        r = (b.get("args") or {}).get("role")
        if r is not None and r not in known:
            out.append((chord_of(b), r))
    return out


def provider_for(name, acts=None):
    a = (acts or actions()).get(name)
    if a is None:
        return None, None
    ident = a.get("implementation")
    prov = PROVIDERS.get(ident) if ident else None
    return a, prov

# Enforcement is a property of the SYSTEM, never of a declaration. An action
# declares its consequence class; it cannot declare that anything checks it.
# Nothing here reads the class before acting and no grant is consulted, so the
# class is advisory and unattended invocation is unavailable. A declared-but-
# unenforced safety property must be VISIBLY incomplete, or the catalogue
# implies a guarantee the system does not make.
# machine-state-bru.5 is where these become "enforced" and grant-dependent.
ENFORCEMENT = "advisory"
UNATTENDED_AVAILABLE = False


# ---------------------------------------------------------------- commands

# How a refusal is worded, per state. The catalogue, the preview and the
# notification must name the SAME state, or the three surfaces disagree about one
# action — which is the thing this whole slice exists to prevent.
#
# This wording was wrong until a keypress exposed it. SUPER + G is bound to a
# declared-but-unimplemented action; the preview correctly showed `missing`,
# while the notification said "Action unavailable". The person who pressed it
# reported back that the action was unavailable, which is not what is true.
#
# The difference is not pedantry, it is what to do next. UNAVAILABLE means the
# provider exists and something it needs is not running — start it, or try
# again later. NOT IMPLEMENTED means nothing will change until code is written,
# and no amount of retrying will help. Collapsing them sends the reader after
# the wrong remedy.
REFUSAL = {
    "unimplemented": ("Not implemented", "{name} is declared but not implemented: {reason}"),
    "unavailable":   ("Unavailable",     "{name} is unavailable: {reason}"),
    "unknown":       ("No such action",  "{name}: {reason}"),
}


def parse_invocation(name, tokens):
    """`name=value` pairs, and nothing else.

    A bare word used to be DISCARDED. `cap act desktop.application.ensure mail`
    therefore asked for no role at all, and the provider was called with no
    arguments — which surfaced as a TypeError naming do_ensure, a function the
    caller never mentioned and did not get wrong.

    This is a usage error, not a refusal: no action was attempted, so nothing is
    journalled. A refusal means the system declined something it understood.
    """
    args = {}
    for tok in tokens:
        if "=" not in tok:
            die(f"{name}: argument {tok!r} is not name=value. Did you mean "
                f"'role={tok}'? A bare word is rejected rather than dropped, "
                f"because dropping it silently asks for something else entirely.")
        k, v = tok.split("=", 1)
        if not k:
            die(f"{name}: argument {tok!r} has an empty name")
        if k in args:
            die(f"{name}: argument {k!r} given more than once")
        args[k] = v
    return args


def check_args(name, args, a):
    """Argument NAMES against the declaration.

    Only names. The declaration records each argument's description, not whether
    it is required or what type it takes, so requiredness cannot be checked here
    without inventing a schema the registry does not have. Saying so is better
    than implying a completeness this does not deliver.
    """
    declared = set((a.get("args") or {}).keys())
    unknown = sorted(k for k in args if k not in declared)
    if unknown:
        die(f"{name}: unknown argument(s) {', '.join(unknown)}; {name} declares "
            f"{', '.join(sorted(declared)) if declared else 'no arguments'}")


def refuse(name, args, phase, reason, caller="agent", state="unavailable"):
    """A declared action that cannot run says so, rather than doing nothing.

    A key bound to an unimplemented action still renders and still fires; pressing
    it produces an explanation instead of apparent silence. That keeps the
    binding, the preview and the catalogue in agreement while letting a
    declaration precede its implementation without presenting false capability.
    """
    title, template = REFUSAL[state]
    msg = template.format(name=name, reason=reason)
    print(f"  refused: {msg}", file=sys.stderr)
    if caller == "keypress":
        subprocess.run(["notify-send", "--app-name=cap", "--urgency=normal",
                        title, msg], capture_output=True)
    # The state goes in the journal too. A corpus that records only "refused"
    # cannot later distinguish "we never built this" from "the desktop was down".
    record(action=name, caller=caller, phase=phase, inputs=args,
           outcome="refused", state=state, reason=reason)
    return 1


def cmd_list(argv):
    """The agent-readable surface. Same actions the key and the preview name."""
    acts = actions()
    if "--json" in argv:
        out = []
        for name, a in sorted(acts.items()):
            implemented, available, reason = action_state(a)
            out.append({
                "action": name, "label": a.get("label"), "category": a.get("category"),
                "args": a.get("args", {}), "mutating": a.get("mutating", True),
                "consequence": a.get("consequence"),
                "enforcement": ENFORCEMENT,
                "unattended": UNATTENDED_AVAILABLE,
                "unattended_reason":
                    "no enforcement or grant mechanism exists yet (machine-state-bru.5)",
                "declared": True,
                "implemented": implemented,
                "available": available,
                "reason": reason,
                "invoke": {"propose": f"cap propose {name}", "act": f"cap act {name}"}})
        print(json.dumps(out, indent=2))
        return 0
    for name, a in sorted(acts.items()):
        implemented, available, reason = action_state(a)
        mark = " " if available else ("!" if not implemented else "x")
        note = "" if available else f"   [{reason}]"
        print(f"  {mark} {name:<34} {a.get('label','')}{note}")
    if not acts:
        print("  (no actions declared)")
    return 0


def cmd_propose(argv):
    if not argv:
        die("usage: cap propose <action> [role=<name>]")
    name = argv[0]
    args = parse_invocation(name, argv[1:])
    a, prov = provider_for(name)
    if a is None:
        return refuse(name, args, "propose", f"no such action {name!r}", "agent", "unknown")
    check_args(name, args, a)
    implemented, available, reason = action_state(a)
    if not available:
        return refuse(name, args, "propose", reason, "agent",
                      "unavailable" if implemented else "unimplemented")
    plan = prov[0](*( [args["role"]] if "role" in args else [] ))
    print(f"  {name}")
    print(f"  branch : {plan['branch']}")
    print(f"  would  : {plan['detail']}")
    record(action=name, caller=os.environ.get("CAP_CALLER", "agent"),
           phase="propose", inputs=args, outcome="ok", plan=plan)
    return 0


def cmd_act(argv):
    if not argv:
        die("usage: cap act <action> [role=<name>]")
    name = argv[0]
    args = parse_invocation(name, argv[1:])
    a, prov = provider_for(name)
    caller = os.environ.get("CAP_CALLER", "agent")
    if a is None:
        return refuse(name, args, "act", f"no such action {name!r}", caller, "unknown")
    check_args(name, args, a)
    implemented, available, reason = action_state(a)
    if not available:
        return refuse(name, args, "act", reason, caller,
                      "unavailable" if implemented else "unimplemented")
    started = now()
    plan, outcome = prov[1](*( [args["role"]] if "role" in args else [] ))
    # A person pressing a key has already expressed intent; an agent proposes
    # first. Same action identity, different authorization context.
    record(action=name, caller=caller, phase="act", inputs=args,
           outcome=outcome, plan=plan, started=started)
    print(f"  {outcome}: {plan['detail']}"
          + (f"\n  {plan['outcome_detail']}" if plan.get("outcome_detail") else ""))
    return 0 if outcome == "ok" else 1


def cmd_preview(_argv):
    """Generated from the same declarations that produce the live bindings.

    BUILT COMPLETELY BEFORE ANYTHING IS PRINTED. A surface that fails partway
    through printing looks like a valid empty surface, which is worse than an
    error: the reader concludes there is nothing rather than that something
    broke. This already happened once — a stale reference crashed after the
    header had been written, and the view read as empty.

    Binding validity and action executability are SEPARATE FACTS and get separate
    columns. A single "ok" spanning both can be read as availability when only
    the chord is sound.

    Owned and observed rows are separated rather than interleaved, because they
    are different KINDS of statement. An owned row says what the machine will do,
    from a declaration. An observed row says what was read out of a file we do
    not author, at a line the reader can go and look at. The second is evidence,
    not description, and the layout should not let one be mistaken for the other.
    """
    try:
        acts = actions()
        vend, unreadable = vendor_bindings()
        owned, mine = [], key_bindings()
        for b in mine:
            chord, a = chord_of(b), acts.get(b["action"])
            free, holder = check_chord(chord, mine)
            if a is None:
                impl, why = "missing", f"no such action {b['action']!r}"
            else:
                implemented, available, reason = action_state(a)
                impl = "ok" if available else ("missing" if not implemented else "unavailable")
                why = reason or ""
            note = why or ("" if free else holder)
            owned.append({"chord": chord, "norm": norm_of(b),
                          "binding": "ok" if free else "CONFLICT", "impl": impl,
                          "what": b["action"] + (f"  — {b['label']}" if b.get("label") else ""),
                          "note": note})
        claimed = {r["norm"] for r in owned}
        groups = {}
        for norm, e in vend.items():
            groups.setdefault((vendor_owner(VENDOR_BINDS), e["source"]), []).append((norm, e))
    except SystemExit:
        raise
    except Exception as exc:
        print(f"cap: preview could not be built: {exc!r}", file=sys.stderr)
        print("Nothing is shown rather than showing part of it.", file=sys.stderr)
        return 1

    w = max([len(r["chord"]) for r in owned] + [18])
    print(f"  OWNED — declared here; these produce the live keys and this table from one source")
    print(f"  {'CHORD':<{w}}  {'BINDING':<9} {'IMPL':<12} ACTION")
    for r in sorted(owned, key=lambda r: r["chord"]):
        print(f"  {r['chord']:<{w}}  {r['binding']:<9} {r['impl']:<12} {r['what']}"
              + (f"   [{r['note']}]" if r["note"] else ""))

    for (owner, src), rows in sorted(groups.items()):
        print(f"\n  OBSERVED — read from {src}, owner {owner}")
        print("  Semantics are not declared anywhere; the expression is shown as written.")
        w2 = max([len(e["declared"]) for _, e in rows] + [18])
        print(f"  {'CHORD':<{w2}}  {'LINE':<6} {'BINDING':<9} EXPRESSION AS WRITTEN")
        for norm, e in sorted(rows, key=lambda p: p[1]["line"]):
            conflict = "CONFLICT" if norm in claimed else "-"
            print(f"  {e['declared']:<{w2}}  {':' + str(e['line']):<6} {conflict:<9} {e['raw']}")

    if unreadable:
        print(f"\n  UNREADABLE — {len(unreadable)} binding(s) whose chord is assembled at load time")
        print("  These hold chords that cannot be listed above, so this table is not the whole keymap.")
        for e in unreadable:
            print(f"  {':' + str(e['line']):<6} {e['expr']}")
    return 0


def cmd_check(_argv):
    """Three things, because three different things can be wrong.

    A chord can be taken. A binding can point at an action that no longer exists.
    And the generated artifact on disk can no longer match what the declarations
    would produce — stale, hand-edited, or left over from an interrupted render.
    Only the first of these was checked before.
    """
    problems = []

    unreadable = vendor_bindings()[1]
    for b in key_bindings():
        chord = chord_of(b)
        free, holder = check_chord(chord)
        risk = unreadable_risk(norm_of(b), unreadable) if free else []
        state = "ok      " if free and not risk else ("UNKNOWN " if free else "CONFLICT")
        print(f"  {state} {chord:<18} {b['action']}"
              + ("" if free else f"  <- {holder}")
              + (f"  <- may be claimed by {risk[0]}" if risk else ""))
        if not free:
            problems.append(f"chord {chord} conflicts ({holder})")
        elif risk:
            problems.append(f"chord {chord} cannot be shown free: {risk[0]}")

    for chord, name in dangling_bindings():
        print(f"  DANGLING {chord:<18} {name}  <- no such action")
        problems.append(f"{chord} references missing action {name!r}")

    for chord, role in dangling_roles():
        print(f"  DANGLING {chord:<18} role={role}  <- no such role")
        problems.append(f"{chord} references missing role {role!r}")

    if RENDERED.exists():
        on_disk, expected = RENDERED.read_text(), render_text()
        if on_disk != expected:
            print(f"  STALE    {'artifact':<18} {RENDERED.relative_to(REPO)}"
                  f"  <- does not match the declarations")
            problems.append("generated artifact is stale or hand-edited")
        else:
            print(f"  ok       {'artifact':<18} {RENDERED.relative_to(REPO)}")
    elif key_bindings():
        print(f"  MISSING  {'artifact':<18} {RENDERED.relative_to(REPO)}  <- never rendered")
        problems.append("generated artifact is missing")

    if problems:
        print(f"\n{len(problems)} problem(s):", file=sys.stderr)
        for p_ in problems:
            print(f"  - {p_}", file=sys.stderr)
    return 1 if problems else 0


def render_text():
    """Exactly the bytes render would write. Pure: no side effects, no I/O beyond
    reading declarations, so check can compare it against what is on disk."""
    lines = ["-- Generated by bin/cap from canonical/bindings/. Do not edit by hand.",
             "-- Change the declaration and run: cap render && ms project", ""]
    for b in key_bindings():
        args = b.get("args", {})
        arg = f" role={args['role']}" if "role" in args else ""
        cmd = f"{REPO}/bin/cap act {b['action']}{arg}"
        lines.append(f'hl.bind("{chord_of(b)}", hl.dsp.exec_cmd("env CAP_CALLER=keypress {cmd}"))')
    return "\n".join(lines) + "\n"


def cmd_render(_argv):
    """Emit the Hyprland fragment for our declared bindings.

    Written into canonical/ and projected by ms, so the key on the machine and
    the preview above come from one declaration. The keypress calls `act`
    directly: the person has already expressed intent.
    """
    # Refuse BEFORE writing anything. A dangling reference would otherwise be
    # baked into the artifact as a stale identity, and the key would call an
    # action that cannot be found.
    #
    # RENDER AND CHECK MUST AGREE ABOUT WHAT IS SAFE. They ask one question at
    # two moments, and a gate laxer than the report that follows it is not a
    # gate: render would write the artifact and say "run ms project", and only a
    # later check would object — after the key was already on the machine.
    #
    # So UNKNOWN refuses here too, deliberately, rather than warning. UNKNOWN
    # means the evidence cannot show the chord is free, and this is the step that
    # decides what reaches the machine. Warning would put the burden on someone
    # noticing a line of output; refusing puts it on choosing a different chord.
    # The refusal names the vendor line so that choice is informed.
    mine = key_bindings()
    unreadable = vendor_bindings()[1]
    conflicts = [chord_of(b) for b in mine if not check_chord(chord_of(b), mine)[0]]
    unknown = [(chord_of(b), r[0]) for b in mine
               if check_chord(chord_of(b), mine)[0]
               and (r := unreadable_risk(norm_of(b), unreadable))]
    dang = dangling_bindings()
    dangr = dangling_roles()
    if conflicts or unknown or dang or dangr:
        for c in conflicts:
            print(f"cap: chord {c} conflicts", file=sys.stderr)
        for c, why in unknown:
            print(f"cap: chord {c} cannot be shown free — {why}", file=sys.stderr)
        for chord, name in dang:
            print(f"cap: {chord} references missing action {name!r}", file=sys.stderr)
        for chord, role in dangr:
            print(f"cap: {chord} references missing role {role!r}", file=sys.stderr)
        die("refusing to render; the previous artifact is left untouched", 1)
    data = render_text().encode()
    RENDERED.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=RENDERED.parent, prefix=".bindings.", suffix=".tmp")
    with os.fdopen(fd, "wb") as fh:
        fh.write(data)
    os.chmod(tmp, 0o644)
    os.replace(tmp, RENDERED)
    print(f"  rendered {len(key_bindings())} binding(s) -> {RENDERED.relative_to(REPO)}")
    print("  run 'ms project' to put it on the machine")
    return 0


COMMANDS = {"list": cmd_list, "propose": cmd_propose, "act": cmd_act,
            "preview": cmd_preview, "check": cmd_check, "render": cmd_render}


def main(argv):
    if os.geteuid() == 0:
        die("refusing to run as root")
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        print("\nusage: cap {" + " | ".join(COMMANDS) + "}")
        return 0 if len(argv) >= 2 else 2
    if argv[1] not in COMMANDS:
        die(f"unknown command {argv[1]!r}; expected one of {', '.join(COMMANDS)}")
    return COMMANDS[argv[1]](argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
