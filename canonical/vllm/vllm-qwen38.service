[Unit]
Description=Local Qwen3.8 27B INT4 inference (vLLM)
After=network.target

[Service]
Type=simple
Environment=HF_HUB_OFFLINE=1
Environment=HF_HOME=%h/.cache/huggingface
Environment=VLLM_ATTENTION_BACKEND=TRITON_ATTN
ExecStart=%h/.local/share/vllm-qwen38/.venv/bin/vllm serve RedHatAI/Qwen3.8-27B-INT4 --host 127.0.0.1 --port 8000 --max-model-len 32768 --max-num-seqs 1 --max-num-batched-tokens 2048 --gpu-memory-utilization 0.95 --enforce-eager --attention-backend TRITON_ATTN --kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_xml
TimeoutStopSec=30
Restart=no
