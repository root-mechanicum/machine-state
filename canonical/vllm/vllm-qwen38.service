[Unit]
Description=Local Qwen3.8 27B INT4 inference (vLLM)
After=network.target
# Autostart only on AC: a loaded model pins ~22 GB VRAM and keeps the dGPU awake.
ConditionACPower=true

[Service]
Type=simple
Environment=HF_HUB_OFFLINE=1
Environment=HF_HOME=%h/.cache/huggingface
Environment=VLLM_ATTENTION_BACKEND=TRITON_ATTN
ExecStart=%h/.local/share/vllm-qwen38/.venv/bin/vllm serve RedHatAI/Qwen3.8-27B-INT4 --host 127.0.0.1 --port 8000 --max-model-len 98304 --max-num-seqs 1 --max-num-batched-tokens 2048 --kv-cache-memory 3720343040 --enforce-eager --attention-backend TRITON_ATTN --kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_xml
TimeoutStopSec=30
Restart=on-failure
RestartSec=30

# No [Install] since 2026-11-07: llama-twin-turbo (canonical/llama-cpp/) is the login default and
# conflicts with this unit. Start this one by hand to switch back; that stops llama-twin-turbo.
