[Unit]
Description=Emit the time.daily event (cap)
# Ordering only: if the model is down or still loading, journal.digest is refused
# as unavailable and the other responses still run. Never Wants= it — the model
# server decides for itself whether to start (AC power only). Either server.
After=strata-flash-next.service llama-twin-turbo.service vllm-qwen38.service

[Service]
Type=oneshot
ExecStart=%h/src/machine-state/bin/cap emit time.daily --source timer
# The home backup runs first and may take up to 40 min after a long absence
# (bin/cap BACKUP_TIMEOUT); the digests after it need their own few minutes.
TimeoutStartSec=60min
