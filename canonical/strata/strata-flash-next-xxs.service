[Unit]
Description=Local Qwen3.8-Flash-Next 177B MoE, ISTA-DASLab GSQ-RCO IQ3_XXS (Strata)
After=network.target
# One GPU and one port: starting this stops IQ3_S and the 27B servers, and starting any of them
# stops this (Conflicts= works both ways).
Conflicts=strata-flash-next.service llama-twin-turbo.service vllm-qwen38.service
ConditionACPower=true

[Service]
Type=simple
# The same engine, MTP draft and image reader as IQ3_S (strata-flash-next.service); only the
# quant's shard 1 and its pack (packs/iq3_xxs) differ. The flags live in strata-iq3_xxs.json,
# owned by Strata's setup (run with --gguf-dir, so it uses the files in place). One value is
# changed from setup's default, to match IQ3_S: --spec 2 (setup: 4). setup's original is kept
# beside it as strata-iq3_xxs.json.setup-default. --max-context 262144 was given to setup.
ExecStart=%h/.local/share/strata/app/.venv/bin/python %h/.local/share/strata/app/serve/server.py --engine strata --config %h/.local/share/strata/app/strata-iq3_xxs.json --port 8000
WorkingDirectory=%h/.local/share/strata/app
TimeoutStartSec=600
TimeoutStopSec=120
Restart=on-failure
# As for IQ3_S: pinned memory is released slowly; a restart within ~70 s fails.
RestartSec=90

# No [Install]: never started at login. A mode, started by hand (or a cap action).
